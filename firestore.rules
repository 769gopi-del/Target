rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Must match the verified admin account configured in index.html.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == '769gopi@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // The signed-in portal reads the shared application catalogue.
    // Only the verified admin account may change it.
    match /appData/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Students can read only their own subscription record.
    // Subscription writes are performed by the trusted Vercel backend
    // using Firebase Admin SDK (which bypasses Firestore client rules).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Payment records are server-only.
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }

    match /razorpayOrders/{orderId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
